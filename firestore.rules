rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isValidEntry() {
      return request.resource.data.keys().hasOnly(['recordKey', 'payload', 'updatedMs'])
        && request.resource.data.keys().hasAll(['recordKey', 'payload', 'updatedMs'])
        && request.resource.data.recordKey is string
        && request.resource.data.recordKey.size() <= 160
        && request.resource.data.payload is map
        && request.resource.data.updatedMs is int;
    }
    function validGymSet(recordId, userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['key', 'sessionKey', 'setId', 'exercise', 'index', 'value', 'revision', 'updatedMs', 'updatedBy'])
        && d.keys().hasAll(['key', 'sessionKey', 'setId', 'exercise', 'index', 'value', 'revision', 'updatedMs', 'updatedBy'])
        && d.key == recordId
        && d.sessionKey is string
        && d.sessionKey.matches('session:[0-9]{4}-[0-9]{2}-[0-9]{2}:(Monday|Tuesday|Wednesday)')
        && d.setId is string && d.setId.matches('s-[0-9a-f]{8}-[0-9]{1,2}')
        && d.key == d.sessionKey + '~' + d.setId
        && d.exercise is string && d.exercise.size() > 0 && d.exercise.size() <= 160
        && d.index is int && d.index >= 0 && d.index <= 30
        && d.value is map
        && d.value.keys().hasOnly(['id', 'kg', 'reps', 'done', 'deleted', 'rir', 'rpe'])
        && d.value.get('id', '') == d.setId
        && ((d.value.get('kg', 0) is number && d.value.get('kg', 0) >= 0 && d.value.get('kg', 0) <= 1200)
          || (d.value.get('kg', '') is string && d.value.get('kg', '').size() <= 20))
        && ((d.value.get('reps', 0) is number && d.value.get('reps', 0) >= 0 && d.value.get('reps', 0) <= 1000)
          || (d.value.get('reps', '') is string && d.value.get('reps', '').size() <= 20))
        && d.value.get('done', false) is bool
        && d.value.get('deleted', false) is bool
        && (!d.value.keys().hasAny(['rir']) || (d.value.rir is int && d.value.rir >= 0 && d.value.rir <= 4))
        && (!d.value.keys().hasAny(['rpe']) || (d.value.rpe is number && d.value.rpe >= 6 && d.value.rpe <= 10))
        && d.revision is int && d.revision >= 1
        && d.updatedMs is int && d.updatedMs > 0
        && d.updatedBy == userId;
    }
    // Milestone 7: independently versioned clock/rest and swimming activity records.
    function validSyncItem(recordId, userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['key','kind','value','revision','updatedMs','updatedBy'])
        && d.keys().hasAll(['key','kind','value','revision','updatedMs','updatedBy'])
        && d.key == recordId && d.key is string && d.key.size() <= 160
        && d.kind in ['clock','swim-segment','rest']
        && (
          (d.kind == 'clock' && recordId.matches('session:[0-9]{4}-[0-9]{2}-[0-9]{2}:(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)~clock'))
          || (d.kind == 'swim-segment' && recordId.matches('session:[0-9]{4}-[0-9]{2}-[0-9]{2}:(Thursday|Friday|Saturday)~[a-zA-Z0-9_-]{1,72}') && !recordId.matches('.*~clock'))
          || (d.kind == 'rest' && recordId == 'rest')
        )
        && (d.value == null || d.value is map)
        && (d.kind != 'clock' || d.value == null || (
          d.value.keys().hasOnly(['startedAt','endedAt','pausedAt','pausedDurationMs'])
          && d.value.get('startedAt','') is string
          && (!d.value.keys().hasAny(['endedAt']) || d.value.endedAt is string)
          && (!d.value.keys().hasAny(['pausedAt']) || d.value.pausedAt is string)
          && (!d.value.keys().hasAny(['pausedDurationMs']) || (d.value.pausedDurationMs is int && d.value.pausedDurationMs >= 0))
        ))
        && (d.kind != 'swim-segment' || d.value == null || (
          d.value.get('id','') is string
          && recordId.split('~')[1] == d.value.id
          && d.value.get('activity','') is string
          && d.value.get('mode','') in ['learning','advanced']
        ))
        && (d.kind != 'rest' || d.value == null || (
          d.value.keys().hasOnly(['startedAt','endsAt','durationSeconds','target'])
          && d.value.startedAt is int && d.value.endsAt is int
          && d.value.durationSeconds is int && d.value.durationSeconds >= 5 && d.value.durationSeconds <= 600
          && (d.value.target == null || d.value.target is map)
        ))
        && d.revision is int && d.revision >= 1
        && d.updatedMs is int && d.updatedMs > 0
        && d.updatedBy == userId;
    }
    match /users/{userId} {
      allow read, write: if false;
      match /gymSessions/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry()
          && request.resource.data.recordKey == recordId
          && recordId.matches('session:[0-9]{4}-[0-9]{2}-[0-9]{2}:(Monday|Tuesday|Wednesday)');
      }
      match /swimSessions/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry()
          && request.resource.data.recordKey == recordId
          && recordId.matches('session:[0-9]{4}-[0-9]{2}-[0-9]{2}:(Thursday|Friday|Saturday)');
      }
      // v3: individual sets use independent, monotonically versioned documents.
      // No client may delete set documents outright; use a deleted tombstone.
      match /syncItems/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validSyncItem(recordId,userId)
          && request.resource.data.revision == 1;
        allow update: if isOwner(userId) && validSyncItem(recordId,userId)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }
      match /gymSets/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validGymSet(recordId, userId)
          && request.resource.data.revision == 1;
        allow update: if isOwner(userId) && validGymSet(recordId, userId)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.sessionKey == resource.data.sessionKey
          && request.resource.data.setId == resource.data.setId
          && request.resource.data.exercise == resource.data.exercise
          && request.resource.data.index == resource.data.index;
        allow delete: if false;
      }
      match /weighIns/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry()
          && request.resource.data.recordKey == recordId
          && recordId.matches('weight:[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
      match /waterEntries/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry()
          && request.resource.data.recordKey == recordId
          && recordId.matches('water:[A-Za-z0-9_-]+');
      }
      match /settings/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEntry()
          && recordId == 'main' && request.resource.data.recordKey == 'preferences';
      }
    }
  }
}
