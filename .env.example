# Firebase web app config from Firebase Console > Project settings > Your apps.
# Public client-side identifiers; they are bundled into the browser. NOT private secrets.
# Populate in Vercel Project > Settings > Environment Variables for Production
# (and Preview if needed), or copy to .env.local for local development.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
